html,
body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  background-color: #f8f8f8;
  text-align: center;
}

h1 {
  background-color: #ff4d6d;
  color: white;
  padding: 20px;
  margin: 0;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  padding: 20px;
  max-width: 1200px;
  margin: auto;
}

.product {
  background-color: white;
  padding: 15px;
  border-radius: 10px;
  box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
  text-align: center;
}

.product img {
  width: 100%;
  height: auto;
  border-radius: 10px;
}

.product h2 {
  font-size: 1.2em;
  margin: 10px 0;
}

.product p {
  font-size: 1.1em;
  color: #333;
  font-weight: bold;
}

/* Button Styling */
.add-to-cart {
  background-color: #ff4d6d;
  color: white;
  border: none;
  padding: 10px 15px;
  font-size: 1em;
  cursor: pointer;
  border-radius: 5px;
  transition: background 0.3s ease;
}

.add-to-cart:hover {
  background-color: #e04360;
}

/* Responsive Design */
@media (max-width: 600px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
