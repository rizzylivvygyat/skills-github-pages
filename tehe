<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bracelet catalog</title>
    <link rel="stylesheet" href="style.css" />
    <script src="script.js" defer></script>
  </head>
  <body>
  
    <nav>
      <ul>
        <li><a href="index.html">Home</a></li>
        <li><a href="cart.html">Cart</a></li>
        <li><a href="checkout.html">Checkout</a></li>
      </ul>
    </nav>

    <h1>Welcome to My Shopping Website!</h1>

    <div class="product-grid">
      <div class="product">
        <img src="IMG_6773.jpg" alt="bracelet_1" />
        <h2>Red and Pink Valentines Bracelet</h2>
        <p>$4.99</p>
        <button class="add-to-cart">Add to Cart</button>
      </div>
      <div class="product">
        <img src="IMG_6789.jpg" alt="bracelet_2" />
        <h2>Bright Valentines Bracelet</h2>
        <p>$2.99</p>
        <button class="add-to-cart">Add to Cart</button>
      </div>
      <div class="product">
        <img src="IMG_6774.jpg" alt="necklace" />
        <h2>Valentines Necklace</h2>
        <p>$6.99</p>
        <button class="add-to-cart">Add to Cart</button>
      </div>
      <div class="product">
        <img src="IMG_6791.jpg" alt="bracelet_3" />
        <h2>Colorful valentines bracelet-heart keychain-</h2>
        <p>$3.99</p>
        <button class="add-to-cart">Add to Cart</button>
      </div>
      <div class="product">
        <img src="IMG_6794.jpg" alt="bracelet_4" />
        <h2>Colorful valentines Bracelet</h2>
        <p>$2.99</p>
        <button class="add-to-cart">Add to Cart</button>
      </div>
      <div class="cart">
        <h2>Shopping Cart</h2>
        <ul class="cart-items"></ul>
        <p class="cart-total">Total: $<span id="cart-total">0.00</span></p>
        <button id="clear-cart">Clear Cart</button>
      </div>
    </div>
  </body>
</html>
